import { ScrollView } from "std-widgets.slint";
import { Icon, IconKind } from "./icons.slint";
import { PageInfo, Pager } from "./pager.slint";

/// Botão compacto de ação de linha.
///
/// Ícone + rótulo curto, sem borda e com superfície sutil: fica visível o bastante
/// para saber onde clicar e leve o bastante para não competir com o nome da
/// ferramenta.
///
/// O rótulo vive dentro de um layout com `alignment: center` — um `Text` solto
/// dentro de um `Rectangle` ocupa só a própria largura, e o texto apareceria
/// deslocado para a esquerda.
component RowButton {
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <IconKind> icon: IconKind.none;
    callback clicked();

    width: layout.preferred-width;
    height: 24px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: touch.pressed
            ? #dedcd9
            : (touch.has-hover ? #e9e8e6 : #f2f1ef);

        layout := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: center;

            if root.icon != IconKind.none: Icon {
                size: 12px;
                kind: root.icon;
                color: #5e5c64;
            }

            Text {
                text: root.text;
                vertical-alignment: center;
                font-size: 12px;
                color: #5e5c64;
                opacity: root.enabled ? 1.0 : 0.4;
            }
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }
}

/// Linha de ferramenta: nome e suas ações explícitas.
///
/// Exportada porque a Home mostra as ferramentas favoritas com a mesma linha.
/// Uma segunda definição de "ferramenta com ações" divergiria da primeira.
///
/// A linha em si não é clicável: o clique teria que significar uma das três
/// ações, e escolher uma delas implicitamente seria arbitrário. O `TouchArea` da
/// linha existe para o realce de hover e é declarado **antes** do conteúdo,
/// porque em Slint quem vem depois é desenhado na frente e capturaria os cliques
/// dos botões.
export component ToolRow {
    in property <string> name: "";
    in property <bool> enabled: true;

    callback run-requested();
    callback open-requested();
    callback actions-requested();

    width: 100%;
    height: 30px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: row-hover.has-hover ? #f2f1ef : transparent;

        row-hover := TouchArea {
            width: 100%;
            height: 100%;
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 10px;
            padding-right: 6px;
            spacing: 4px;

            Text {
                text: root.name;
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-size: 13px;
                color: #1c1c1c;
                overflow: elide;
            }

            RowButton {
                text: "Executar";
                icon: IconKind.play;
                enabled: root.enabled;
                clicked => { root.run-requested(); }
            }

            RowButton {
                text: "Abrir";
                icon: IconKind.folder;
                enabled: root.enabled;
                clicked => { root.open-requested(); }
            }

            RowButton {
                text: "Ações";
                icon: IconKind.dots;
                enabled: root.enabled;
                clicked => { root.actions-requested(); }
            }
        }
    }
}

/// Lista de ferramentas, cada linha com suas ações, com scroll e paginação.
///
/// Não há seleção: as ações são explícitas por linha. `items` é **a página
/// exibida** (a UI não consegue fatiar um modelo, então o recorte vem pronto do
/// app), e o índice informado nos callbacks é a posição dentro dela — o mesmo
/// índice que o app usa para achar a ferramenta na lista que ele mesmo recortou.
export component ToolList {
    in property <[string]> items: [];
    in property <bool> enabled: true;
    in property <string> empty-text: "";
    /// Sem paginação o padrão basta: uma página com o que foi dado.
    in property <PageInfo> page-info: { page: 0, page-count: 1, total: 0, offset: 0 };
    /// Itens por página, só para o rótulo da faixa exibida.
    in property <int> page-size: 10;

    callback run-requested(int);
    callback open-requested(int);
    callback actions-requested(int);
    callback page-requested(int);

    // Preenche a caixa da lista: `100%` no elemento raiz resolveria contra a instância.
    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        if root.items.length == 0: Text {
            text: root.empty-text;
            color: #9a9996;
            font-size: 13px;
            wrap: word-wrap;
        }

        if root.items.length > 0: VerticalLayout {
            width: 100%;
            height: 100%;
            // Espaço só entre lista e paginador; sem paginador, nada aparece.
            spacing: 6px;

            ScrollView {
                width: 100%;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    for item[idx] in root.items: ToolRow {
                        name: item;
                        enabled: root.enabled;
                        run-requested => { root.run-requested(idx); }
                        open-requested => { root.open-requested(idx); }
                        actions-requested => { root.actions-requested(idx); }
                    }
                }
            }

            // `if` e não `visible`: em Slint um item invisível ainda ocupa lugar, e
            // o paginador de uma lista de página única reservaria altura sem ter o
            // que mostrar.
            if root.page-info.page-count > 1: Pager {
                info: root.page-info;
                page-size: root.page-size;
                enabled: root.enabled;
                previous-requested => { root.page-requested(root.page-info.page - 1); }
                next-requested => { root.page-requested(root.page-info.page + 1); }
            }
        }
    }
}
