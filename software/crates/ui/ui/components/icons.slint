export component IconDots {
    in property <brush> color: #1c1c1c;
    IconPath {
        width: 100%;
        height: 100%;
        color: root.color;
        filled: true;
        // Três pontos cheios: um por vez, para o preenchimento não depender da
        // direção de enrolamento entre subcaminhos.
        commands: "M 9.25 3.3 C 9.25 3.99 8.69 4.55 8 4.55 C 7.31 4.55 6.75 3.99 6.75 3.3 C 6.75 2.61 7.31 2.05 8 2.05 C 8.69 2.05 9.25 2.61 9.25 3.3 Z M 9.25 8 C 9.25 8.69 8.69 9.25 8 9.25 C 7.31 9.25 6.75 8.69 6.75 8 C 6.75 7.31 7.31 6.75 8 6.75 C 8.69 6.75 9.25 7.31 9.25 8 Z M 9.25 12.7 C 9.25 13.39 8.69 13.95 8 13.95 C 7.31 13.95 6.75 13.39 6.75 12.7 C 6.75 12.01 7.31 11.45 8 11.45 C 8.69 11.45 9.25 12.01 9.25 12.7 Z";
    }
}

