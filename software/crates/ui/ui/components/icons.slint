/// Ícones do UIGE, desenhados como `Path`.
///
/// Motivo de não usar glifo de fonte nem imagem:
///
/// - glifo de fonte muda de forma e de métrica entre sistemas;
/// - emoji traz cor própria e brigaria com o tema claro fixo;
/// - `Path` mantém o traço monocromático, com cor vinda de `color`, e escala sem
///   asset externo.
///
/// Convenções: grade de 16x16, traço de 1.5px, contorno quando o ícone representa
/// uma ação e preenchimento quando representa estado (favorito, menu).
/// O consumidor escolhe `width`/`height` e `color`.

/// Catálogo de ícones usado nos controles (botões, navegação, listas).
///
/// Existe para um controle aceitar "que ícone" sem precisar de `@children`: o
/// valor viaja como propriedade e o desenho fica em `Icon`.
export enum IconKind {
    none,
    play,
    folder,
    save,
    plus,
    minus,
    search,
    close,
    dots,
    star,
    star-outline,
    home,
    tools,
    profiles,
    workflows,
    settings,
    back,
    check,
    chevron,
}

component IconPath {
    in property <brush> color: #1c1c1c;
    in property <length> thickness: 1.5px;
    in property <string> commands: "";
    in property <bool> filled: false;

    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.commands;
        fill: root.filled ? root.color : transparent;
        stroke: root.filled ? transparent : root.color;
        stroke-width: root.thickness;
    }
}

export component IconPlay {
    in property <brush> color: #1c1c1c;
    IconPath { width: 100%; height: 100%; color: root.color; filled: true; commands: "M 5 3 L 12.8 8 L 5 13 Z"; }
}

