/// Seta para baixo: marca um controle que abre uma lista (não é ação).
export component IconChevron {
    in property <brush> color: #1c1c1c;
    IconPath { width: 100%; height: 100%; color: root.color; commands: "M 4.4 6.4 L 8 10 L 11.6 6.4"; }
}

/// Despacha o desenho pelo `kind`.
///
/// O consumidor informa só `size` (lado do desenho). A caixa externa acompanha a
/// linha e o desenho é centralizado dentro dela.
///
/// `min-height` (e não `height`) é o que permite isso: em Slint, um item de layout
/// com altura **explícita** é alinhado ao **início** do eixo cruzado, e o ícone
/// aparecia acima do centro da linha — no trilho da sidebar e no `+` dos botões.
/// Com `min-height` + `vertical-stretch`, a caixa recebe a altura da linha e o
/// desenho continua com `size` fixo, centralizado. Fora de layout (sem linha a
/// acompanhar), a altura fica no próprio `size`, que é o esperado.
export component Icon {
    in property <IconKind> kind: IconKind.none;
    in property <brush> color: #1c1c1c;
    /// Lado do quadrado desenhado.
    in property <length> size: 16px;

    width: root.size;
    min-height: root.size;
    vertical-stretch: 1;

    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.size;
            height: root.size;
            background: transparent;

            if root.kind == IconKind.play: IconPlay { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.folder: IconFolder { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.save: IconSave { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.plus: IconPlus { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.minus: IconMinus { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.search: IconSearch { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.close: IconClose { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.dots: IconDots { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.star: IconStar { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.star-outline: IconStarOutline { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.home: IconHome { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.tools: IconTools { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.profiles: IconProfiles { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.workflows: IconWorkflows { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.settings: IconSettings { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.back: IconBack { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.check: IconCheck { width: 100%; height: 100%; color: root.color; }
            if root.kind == IconKind.chevron: IconChevron { width: 100%; height: 100%; color: root.color; }
        }
    }
}
