import { ComboBox } from "std-widgets.slint";
import { IconKind } from "./icons.slint";
import { LightPrimaryButton, LightSecondaryButton, LightTextField } from "./light-controls.slint";
import { Modal } from "./modal.slint";

/// Detalhamento de **uma** etapa do Workflow.
///
/// A tela de criação monta a sequência; cada etapa é detalhada aqui, uma por vez:
/// ferramenta, ação, parâmetro, workdir e o que fazer se a etapa falhar. Antes
/// disso a etapa era montada por combos fixos na própria tela, e o que não
/// coubesse neles (workdir, parâmetro) ficava sem lugar.
///
/// Abre com ferramenta e ação **já escolhidas** (a seleção da etapa anterior, ou
/// a primeira de cada lista): o caso comum é repetir a ferramenta, e uma etapa
/// nunca nasce sem ação.
///
/// O Workdir é digitado, não escolhido por navegação: o seletor de pastas é um
/// modal, e abrir um modal sobre outro é o que esta fatia veio corrigir. Vazio
/// herda o Workdir global do Workspace.
export component WorkflowStepDialog {
    in-out property <bool> open: false;
    in-out property <bool> busy: false;

    in property <[string]> tool-names: [];
    in-out property <int> selected-tool: 0;
    in property <[string]> command-names: [];
    in-out property <int> selected-command: 0;

    in-out property <bool> show-param: false;
    in-out property <string> param-label: "Parâmetro";
    in-out property <string> param-text: "";

    in-out property <string> workdir-text: "";
    in-out property <int> selected-on-error: 0;

    in-out property <string> error-text: "";

    callback selection-changed();
    callback close-requested();
    callback confirm-requested();

    width: 100%;
    height: 100%;

    Modal {
        width: 100%;
        height: 100%;
        open: root.open;
        busy: root.busy;
        title: "Adicionar etapa";
        panel-width: 420px;
        close-requested => {
            if (!root.busy) {
                root.close-requested();
            }
        }

        Text {
            text: "Cada etapa roda uma ação de uma ferramenta, na ordem em que for adicionada.";
            wrap: word-wrap;
            color: #9a9996;
            font-size: 12px;
        }

        Text {
            text: "Ferramenta";
            font-size: 12px;
            font-weight: 600;
            color: #5e5c64;
        }

        ComboBox {
            model: root.tool-names;
            current-index <=> root.selected-tool;
            enabled: !root.busy && root.tool-names.length > 0;
            selected => { root.selection-changed(); }
        }

        Text {
            text: "Ação";
            font-size: 12px;
            font-weight: 600;
            color: #5e5c64;
        }

        ComboBox {
            model: root.command-names;
            current-index <=> root.selected-command;
            enabled: !root.busy && root.command-names.length > 0;
            selected => { root.selection-changed(); }
        }

        if root.show-param: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.param-label;
                font-size: 12px;
                font-weight: 600;
                color: #5e5c64;
            }

            LightTextField {
                text <=> root.param-text;
                enabled: !root.busy;
            }
        }

        Text {
            text: "Workdir da etapa";
            font-size: 12px;
            font-weight: 600;
            color: #5e5c64;
        }

        LightTextField {
            text <=> root.workdir-text;
            enabled: !root.busy;
            placeholder: "Vazio herda o Workdir global";
        }

        Text {
            text: "Se esta etapa falhar";
            font-size: 12px;
            font-weight: 600;
            color: #5e5c64;
        }

        ComboBox {
            // Índices fixos: 0 = parar, 1 = continuar (espelhados no core).
            model: ["Parar o workflow", "Continuar na próxima etapa"];
            current-index <=> root.selected-on-error;
            enabled: !root.busy;
        }

        if root.error-text != "": Text {
            text: root.error-text;
            wrap: word-wrap;
            color: #c01c28;
            font-size: 12px;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            LightSecondaryButton {
                text: "Cancelar";
                enabled: !root.busy;
                clicked => {
                    root.close-requested();
                }
            }

            LightPrimaryButton {
                text: "Adicionar etapa";
                icon: IconKind.plus;
                enabled: !root.busy && root.command-names.length > 0;
                clicked => {
                    root.confirm-requested();
                }
            }
        }
    }
}
