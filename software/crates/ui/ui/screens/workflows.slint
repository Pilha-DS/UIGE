import { ScrollView } from "std-widgets.slint";
import { IconKind } from "../components/icons.slint";
import { LightPrimaryButton, LightSecondaryButton } from "../components/light-controls.slint";
import { PageBody } from "../components/page-body.slint";
import { PageInfo } from "../components/pager.slint";
import { SelectList } from "../components/select-list.slint";

/// Workflows: sequência ordenada de etapas.
///
/// A tela concentra a lista, a criação e a execução. O bloco escuro mostra a
/// **definição** das etapas ou o **resultado** da execução — o título diz qual
/// dos dois.
///
/// A lista de workflows é uma `SelectList` e não um combo: é ela que concentra
/// todos os workflows existentes, e a paginação fica com a lista — um dropdown
/// não pagina.
export component WorkflowsScreen {
    in property <[string]> workflow-names: [];
    in-out property <int> selected-workflow: 0;
    in property <PageInfo> workflow-page-info: { page: 0, page-count: 1, total: 0, offset: 0 };
    in property <[string]> step-results: [];
    in property <string> steps-title: "Etapas";
    in property <[string]> history-labels: [];
    in-out property <int> selected-history: 0;
    in property <PageInfo> history-page-info: { page: 0, page-count: 1, total: 0, offset: 0 };
    in property <bool> busy: false;

    callback workflow-selection-changed();
    callback workflow-page-requested(int);
    callback history-selection-changed();
    callback history-page-requested(int);
    callback run-requested();
    callback create-workflow-requested();

    // Preenche o pai: `100%` no elemento raiz resolveria contra a instância.
    width: 100%;
    height: 100%;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff;

        PageBody {
            // A tela cresce com as listas; o scroll mantém tudo alcançável em
            // janelas baixas em vez de cortar o fim da coluna.
            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 8px;

                    Text {
                        text: "Workflows";
                        font-size: 18px;
                        font-weight: 600;
                        color: #1c1c1c;
                    }

                    // Superfície do grupo: a lista se separa do fundo pelo tom.
                    Rectangle {
                        height: 124px;
                        border-radius: 8px;
                        background: #f7f6f5;
                        clip: true;

                        SelectList {
                            items: root.workflow-names;
                            selected-index <=> root.selected-workflow;
                            page-info: root.workflow-page-info;
                            enabled: !root.busy;
                            empty-text: "Nenhum workflow criado.";
                            selected => {
                                root.workflow-selection-changed();
                            }
                            page-requested(page) => {
                                root.workflow-page-requested(page);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        LightSecondaryButton {
                            text: "Criar";
                            icon: IconKind.plus;
                            enabled: !root.busy;
                            clicked => {
                                root.create-workflow-requested();
                            }
                        }

                        LightPrimaryButton {
                            text: root.busy ? "Executando…" : "Executar";
                            icon: IconKind.play;
                            enabled: !root.busy && root.workflow-names.length > 0;
                            clicked => {
                                root.run-requested();
                            }
                        }
                    }

                    Text {
                        text: root.steps-title;
                        font-size: 12px;
                        font-weight: 600;
                        color: #5e5c64;
                    }

                    Rectangle {
                        height: 120px;
                        border-radius: 8px;
                        background: #242424;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #0000001a;
                        drop-shadow-offset-y: 2px;

                        ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                if root.step-results.length == 0: Text {
                                    text: "Sem etapas para mostrar.";
                                    color: #9a9996;
                                    font-size: 12px;
                                }

                                for label in root.step-results: Text {
                                    text: label;
                                    wrap: word-wrap;
                                    color: #f6f5f4;
                                    font-family: "Consolas";
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Execuções anteriores";
                        font-size: 12px;
                        font-weight: 600;
                        color: #5e5c64;
                    }

                    Rectangle {
                        height: 100px;
                        border-radius: 8px;
                        background: #f7f6f5;
                        clip: true;

                        SelectList {
                            items: root.history-labels;
                            selected-index <=> root.selected-history;
                            page-info: root.history-page-info;
                            enabled: !root.busy;
                            empty-text: "Nenhuma execução registrada.";
                            selected => {
                                root.history-selection-changed();
                            }
                            page-requested(page) => {
                                root.history-page-requested(page);
                            }
                        }
                    }
                }
            }
        }
    }
}
